{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://clubs-avandata-api.onrender.com/api/:path*"
    },
    {
      "source": "/((?!api/|assets/|icons/|fonts/|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
