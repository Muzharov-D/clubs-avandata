{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
  {
    "source": "/ffspb-api/:path*",
    "destination": "https://ffspb.org/api/:path*"
  },
  {
    "source": "/av-api/:path*",
    "destination": "https://back.avandata.ru/:path*"
  },
  {
    "source": "/api/:path*",
    "destination": "https://clubs-avandata-api.onrender.com/api/:path*"
  },
  {
    "source": "/((?!api/|av-api/|ffspb-api/|assets/|icons/|fonts/|.*\\.).*)",
    "destination": "/index.html"
  }
],
  "headers": [
    {
      "source": "/",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=0, must-revalidate, s-maxage=0"}
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=0, must-revalidate, s-maxage=0"}
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=0, must-revalidate, s-maxage=0"}
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}
      ]
    }
  ]
}
