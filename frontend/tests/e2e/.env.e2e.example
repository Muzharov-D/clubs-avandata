# ── E2E учётки и настройки ───────────────────────────────────────────────
# Скопируй в .env.e2e (тот файл в .gitignore — НЕ коммитится) и заполни.
# Без учёток auth-зависимые тесты помечаются skip, smoke/public — работают.

# Базовый URL (по умолчанию боевой Vercel-деплой)
# E2E_BASE_URL=https://clubs-avandata.vercel.app

# platform_admin — нужен для admin-тестов (список/создание/удаление клуба)
E2E_ADMIN_USERNAME=
E2E_ADMIN_PASSWORD=

# Тренер (head_coach), напр. legirus-2010 — для дашборда/навигации кабинета
E2E_COACH_USERNAME=
E2E_COACH_PASSWORD=

# Игрок (опционально) — для own-player-only флоу
# E2E_PLAYER_USERNAME=
# E2E_PLAYER_PASSWORD=

# Публичный родительский экран для smoke (/m/{slug}/team/{age})
# E2E_PUBLIC_SLUG=legirus
# E2E_PUBLIC_AGE=2010
